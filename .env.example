# Contraseña obligatoria (mínimo 16 caracteres). La API la usa para conectarse.
# Compatibilidad: si solo defines REDIS_PASSWORD, también se usa.
VALKEY_PASSWORD=<VALKEY_PASSWORD>
# Memoria máxima; al llenarse se descartan las llaves menos usadas.
VALKEY_MAXMEMORY=128mb
VALKEY_DATABASES=4
# Hilos de E/S de Valkey (por defecto 4; con 1 CPU asignada conviene 1).
VALKEY_IO_THREADS=4
# Opcional: socket UNIX además de TCP 6379. Su carpeta debe ser un volumen escribible compartido con la API.
# VALKEY_SOCKET=/var/run/smartpot/valkey.sock
